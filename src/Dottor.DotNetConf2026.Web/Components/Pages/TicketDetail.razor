@page "/demo/tickets/{Id:int}"
@inject TicketCatalog Tickets

<PageTitle>Dettaglio ticket</PageTitle>
<h1>Dettaglio ticket #@Id</h1>
@if (Tickets.Find(Id) is { } ticket)
{
    <dl class="row">
        <dt class="col-sm-3">Titolo</dt><dd class="col-sm-9">@ticket.Title</dd>
        <dt class="col-sm-3">Priorità</dt><dd class="col-sm-9">@ticket.Priority</dd>
        <dt class="col-sm-3">Stato</dt><dd class="col-sm-9">@ticket.Status</dd>
        <dt class="col-sm-3">Creazione</dt><dd class="col-sm-9">@ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Assegnato a</dt><dd class="col-sm-9">@ticket.AssignedTo</dd>
    </dl>
}
else
{
    <p class="alert alert-warning">Ticket non presente.</p>
}
<p>Usa Back del browser per tornare alla stessa pagina e allo stesso ordinamento.</p>
<a href="demo/quickgrid">Apri la griglia iniziale</a>

@code {
    [Parameter]
    public int Id { get; set; }
}