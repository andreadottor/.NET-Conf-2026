@page "/demo/circuit-pause"
@using Dottor.DotNetConf2026.Web.Shutdown
@using Microsoft.Extensions.Options
@inject DemoInstance Instance
@inject ShutdownCircuitHandler Connection
@inject IOptions<AutoPauseDemoOptions> AutoPauseOptions

<PageTitle>Circuit Pause & Resume</PageTitle>
<h1>Circuit Pause &amp; Resume</h1>
<p class="lead">Il circuito può essere messo in pausa dal server (deployment) o dal browser (scheda nascosta).
    In entrambi i casi solo lo stato esplicitamente persistibile viene ripristinato.</p>

<dl class="row diagnostic">
    <dt class="col-sm-3">Versione applicazione</dt><dd class="col-sm-9" id="app-version">@Instance.Version</dd>
    <dt class="col-sm-3">PID server</dt><dd class="col-sm-9" id="server-pid">@Instance.ProcessId</dd>
    <dt class="col-sm-3">Circuito corrente</dt><dd class="col-sm-9 text-break" id="circuit-id">@(Connection.CircuitId ?? "Non ancora connesso (prerendering)")</dd>
    <dt class="col-sm-3">Connessione</dt><dd class="col-sm-9" id="circuit-status">@(Connection.IsConnected ? "Connesso - Interactive Server" : "Prerendering: interattività in avvio")</dd>
    <dt class="col-sm-3">Componente creato alle</dt><dd class="col-sm-9" id="component-created">@componentCreatedAt.ToString("HH:mm:ss") <small class="text-body-secondary">(campo non persistito: cambia a ogni ripresa)</small></dd>
    <dt class="col-sm-3">Pausa automatica</dt>
    <dd class="col-sm-9" id="autopause-config">
        @if (AutoPauseOptions.Value.Enabled)
        {
            <span>Attiva dopo <strong>@AutoPauseOptions.Value.HiddenDelay.TotalSeconds secondi</strong> di scheda nascosta (default del pacchetto: @AutoPauseDemoOptions.PackageDefaultHiddenDelay.TotalMinutes minuti)</span>
        }
        else
        {
            <span>Disattivata dalla configurazione (<code>AutoPause:Enabled=false</code>)</span>
        }
    </dd>
</dl>

<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr><th scope="col"></th><th scope="col">Pausa richiesta dal server</th><th scope="col">Pausa automatica (scheda nascosta)</th></tr>
        </thead>
        <tbody>
            <tr><th scope="row">Chi la avvia</th><td><code>Circuit.RequestCircuitPauseAsync()</code> durante lo shutdown</td><td>Il browser, dopo <code>HiddenDelay</code> con <code>visibilityState = hidden</code></td></tr>
            <tr><th scope="row">Abilitazione</th><td>API del framework</td><td>Opt-in: pacchetto <code>Components.Server.AutoPause</code> + <code>WithBrowserOptions</code></td></tr>
            <tr><th scope="row">Ripresa</th><td>Il dialog attende <code>/health</code> della nuova istanza</td><td>Al ritorno sulla scheda (pulsante Riprendi come riserva)</td></tr>
            <tr><th scope="row">PID / versione</th><td>Cambiano</td><td>Restano uguali</td></tr>
            <tr><th scope="row">Circuit ID e campi non persistiti</th><td colspan="2" class="text-center">Cambiano: viene creato un nuovo circuito con lo stato <code>[PersistentState]</code></td></tr>
        </tbody>
    </table>
</div>
<p class="fs-4">Contatore: <strong id="counter-value">@Count</strong></p>
<button id="increment-counter" class="btn btn-primary mb-3" @onclick="() => Count++">Incrementa</button>

<form @onsubmit:preventDefault>
    <div class="mb-3">
        <label for="ticket-title" class="form-label">Titolo del ticket</label>
        <input id="ticket-title" class="form-control" @bind="Title" @bind:event="oninput" />
    </div>
    <div class="mb-3">
        <label for="ticket-description" class="form-label">Descrizione (bozza non salvata)</label>
        <textarea id="ticket-description" class="form-control" rows="4" @bind="Description" @bind:event="oninput"></textarea>
    </div>
</form>


@code {
    private readonly DateTimeOffset componentCreatedAt = DateTimeOffset.Now;

    [PersistentState]
    public int Count { get; set; }
    [PersistentState]
    public string? Title { get; set; }
    [PersistentState]
    public string? Description { get; set; }
}