<script type="module" src="~/Components/Layout/NavMenu.razor.js"></script>

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">.NET Conf 2026</a>
    </div>
</div>

<nav-menu>
    <input type="checkbox" title="Menu di navigazione" class="navbar-toggler" />

    <div class="nav-scrollable">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>

            @foreach (var demo in DemoCatalog.All)
            {
                <div class="nav-item px-3" @key="demo.Slug">
                    <NavLink class="nav-link" href="@($"demo/{demo.Slug}")">@demo.Title</NavLink>
                </div>
            }
        </nav>
    </div>
</nav-menu>

