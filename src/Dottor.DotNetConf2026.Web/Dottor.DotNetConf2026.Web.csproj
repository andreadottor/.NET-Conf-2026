<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <LangVersion>15.0</LangVersion>
    <!-- AnchorMode is an experimental .NET 11 API used by the virtualization demo. -->
    <NoWarn>$(NoWarn);ASP0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Server.AutoPause" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
  </ItemGroup>

</Project>
